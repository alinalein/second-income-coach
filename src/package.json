{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@app/shared": "*",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "1.7.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.3",
    "@langchain/mcp-adapters": "^2.0.3",
    "@langchain/openai": "^1.8.4",
    "@mistralai/mistralai": "^3.5.0",
    "bytes": "^3.1.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "langchain": "1.6.5",
    "pg": "^8.23.1",
    "tavily-mcp": "^0.2.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
