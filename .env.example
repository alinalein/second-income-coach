# Copy to .env and fill in the empty values. Validated at backend startup
# (src/config/env.ts): a missing or invalid required variable stops the
# server with a message naming it. Placeholders only, never commit real keys.
#
# Sections: 1 Fill in (secrets) | 2 Works as is | 3 Demo & cost limits | 4 Dev ports


# =============================================================================
# 1. FILL IN — secrets and keys
# =============================================================================

# Google sign-in (OAuth client, type "Web application").
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate: openssl rand -hex 32. Never reuse across environments.
SESSION_SECRET=

# Models, transcription (voice) and embeddings: one key for all (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Moderation of every user message and agent reply (https://console.mistral.ai/api-keys).
MISTRAL_API_KEY=

# Web search for idea generation (https://app.tavily.com). Only used when WEB_SEARCH_MODE=live.
TAVILY_API_KEY=

# Tracing of every agent turn (https://smith.langchain.com). TRACING must be "true" or "false".
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=


# =============================================================================
# 2. WORKS AS IS — local defaults, change only if needed
# =============================================================================

NODE_ENV=development
PORT=3000

# Local Docker Compose Postgres (docker-compose.yml uses the same defaults).
DATABASE_URL=postgres://second_income_coach:second_income_coach@localhost:5432/second_income_coach
POSTGRES_USER=second_income_coach
POSTGRES_PASSWORD=second_income_coach
POSTGRES_DB=second_income_coach
POSTGRES_PORT=5432

# Browser origin allowed by CORS (the Vite dev server locally).
CORS_ORIGIN=http://localhost:5173

# Must match an "Authorized redirect URI" on the Google OAuth client. Uses the
# Vite port (WEB_PORT), not the API port; change both together.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Session cookie name. A parallel dev lane sets its own so cookies don't clash.
SESSION_COOKIE_NAME=sic.sid

# General rate limit (requests per window) and max JSON body size.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
BODY_LIMIT=100kb

# LangSmith project and the dataset for rated traces (offline prompt improvement
# only, never model training; optional).
LANGSMITH_PROJECT=second-income-coach
LANGSMITH_FEEDBACK_DATASET=second-income-coach-feedback


# =============================================================================
# 3. DEMO & COST LIMITS — idea generation and web search
# =============================================================================

# Ideas per generation (1-5).
IDEAS_PER_BATCH=3

# "stub" = canned results, no network, no Tavily credits (tests and most dev).
# "live" = real Tavily search, costs credits (demo). Each run is capped at 6 searches.
WEB_SEARCH_MODE=stub

# Counters live in Postgres and reset at UTC midnight. Defaults are generous for
# development; for the live demo use e.g. DAILY_SEARCH_BUDGET=60, DAILY_GENERATIONS_PER_USER=5.
DAILY_SEARCH_BUDGET=500
DAILY_GENERATIONS_PER_USER=50

# Comma-separated owner emails exempt from DAILY_GENERATIONS_PER_USER only (the
# search budget and per-run cap still apply). Empty = nobody. Keep real addresses
# out of this file, e.g. UNLIMITED_USER_EMAILS=owner@example.com
UNLIMITED_USER_EMAILS=


# =============================================================================
# 4. DEV PORTS — read only by web/vite.config.ts, not validated by the backend
# =============================================================================

# Lets a parallel worktree run its own frontend+backend pair. If you change
# WEB_PORT, also update GOOGLE_REDIRECT_URI and CORS_ORIGIN to match.
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:3000
