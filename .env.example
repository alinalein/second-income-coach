# Copy this file to .env and fill in real values for local development.
# All variables listed here are validated at backend startup (src/config/env.ts);
# the process exits with a clear error if a required one is missing or invalid.

# Runtime mode: development | test | production
NODE_ENV=development

# Port the Express API listens on
PORT=3000

# Postgres connection string for the local Docker Compose instance
# (matches docker-compose.yml's default service credentials)
DATABASE_URL=postgres://second_income_coach:second_income_coach@localhost:5432/second_income_coach

# Same-origin allowlist for CORS. In local dev this is the Vite dev server origin;
# in production the frontend is served from this same Express origin.
CORS_ORIGIN=http://localhost:5173

# express-rate-limit (general tier) window + max requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Max request body size accepted by the Express JSON body parser
BODY_LIMIT=100kb

# Local Docker Compose Postgres service credentials (docker-compose.yml reads
# these with the same defaults shown here; only needed if you want to override them)
POSTGRES_USER=second_income_coach
POSTGRES_PASSWORD=second_income_coach
POSTGRES_DB=second_income_coach
POSTGRES_PORT=5432

# Google OAuth 2.0 client (authorization-code flow, via google-auth-library).
# Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" configured on that OAuth
# client. Locally this is the Vite dev server origin (WEB_PORT below), NOT
# the Express API port — the browser reaches the callback through Vite's
# `/api` proxy, so the session cookie Express sets ends up scoped to the
# origin the browser actually talked to. If you change WEB_PORT, update this too.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Secret used to sign the session-id cookie (express-session). Generate a
# long random value, e.g. `openssl rand -hex 32` — never reuse across environments.
SESSION_SECRET=

# Story 1.3: core agent loop, moderation, and observability.

# OpenRouter API key for the agent's model (gpt-6-luna, routed through
# OpenRouter's OpenAI-compatible endpoint as "openai/gpt-6-luna" — one key
# covers every provider in the model registry, not just OpenAI).
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral API key, used to call Mistral Moderation 2 (mistral-moderation-2603)
# on every user message and agent reply before it's processed or shown.
# Create one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# LangSmith observability — a trace is recorded for every agent turn.
# LANGSMITH_TRACING must be the literal string "true" or "false".
# Create a key/project at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=second-income-coach

# Dev-only, code-defaulted (NOT part of src/config/env.ts's required startup
# validation — the backend doesn't read these, only web/vite.config.ts does).
# Lets a parallel worktree run its own frontend+backend pair on different
# ports without editing source. Defaults: WEB_PORT=5173, API_PROXY_TARGET=http://localhost:3000.
# If you change WEB_PORT, also update GOOGLE_REDIRECT_URI and CORS_ORIGIN to match.
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:3000
